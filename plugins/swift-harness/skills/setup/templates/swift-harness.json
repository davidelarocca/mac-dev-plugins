{
  "format": "swiftformat",
  "lint": "swiftlint",
  "lintBlocking": false,
  "verify": {
    "enabled": true,
    "command": "scripts/verify.sh fast",
    "maxAttempts": 3
  },
  "protectedPaths": ["{{PROTECTED_PATH}}"],
  "registry": {
    "sources": ["{{DESIGN_SYSTEM_PATH}}"]
  },
  "guardPbxproj": true
}
